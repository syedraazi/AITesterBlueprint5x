{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": ".",
      "framework": "express",
      "entrypoint": "api/[...route].mjs",
      "functions": {
        "api/[...route].mjs": {
          "includeFiles": "vwo-login-dashboard-test-cases.xlsx"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
