{
  "name": "intelligent-test-plan",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node src/backend/server.js",
    "dev:frontend": "vite --config vite.config.mjs --host 127.0.0.1 --port 5181 --strictPort",
    "build": "vite build --config vite.config.mjs",
    "start": "node src/backend/server.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "dotenv": "latest",
    "express": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "concurrently": "latest"
  }
}
